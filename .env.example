RESEND_API_KEY=re_xxx                # Resend transactional email
CONTACT_EMAIL=caro@dshairbeauty.co.uk

# ── Anti-spam (Turnstile) — added 2026-08-18 ───────────────────────
# Until BOTH are set, all Turnstile/honeypot/timing checks fail OPEN
# (spam protection is inactive but the site still works).
#
# 1. Create a FREE Turnstile widget at https://dash.cloudflare.com/  → Turnstile
#    - Domain: dshairbeauty.co.uk
# 2. Copy the Site Key  → NEXT_PUBLIC_TURNSTILE_SITE_KEY (exposed to browser)
# 3. Copy the Secret Key → TURNSTILE_SECRET_KEY (server-only, never expose)
#
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
